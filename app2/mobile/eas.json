{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PLACES_URL": "https://tinytoolshedhq.github.io/app/places",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.toiletgo.app.fullpack",
        "EXPO_PUBLIC_IAP_SIMULATE": "1"
      }
    },
    "preview-ios-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PLACES_URL": "https://tinytoolshedhq.github.io/app/places",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.toiletgo.app.fullpack"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_PLACES_URL": "https://tinytoolshedhqorg.github.io/app/places-staging",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.toiletgo.app.fullpack"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6798266716"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6798266716"
      }
    }
  }
}
