{
  "expo": {
    "name": "伸展",
    "slug": "stretch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stretch",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tinytoolshed.stretch",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh-Hant",
        "CFBundleLocalizations": [
          "en",
          "zh-Hant"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app does not read your photos and does not save or export images. It would use photo library access only to copy a photo into the app when given that photo's library address."
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "package": "com.tinytoolshed.stretch",
      "adaptiveIcon": {
        "backgroundColor": "#E8F2EC",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hant"
            ],
            "android": [
              "en",
              "zh-Hant",
              "zh-TW",
              "zh-HK"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-iap",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font"
    ],
    "locales": {
      "en": "./languages/ios/en.json",
      "zh-Hant": "./languages/ios/zh-Hant.json",
      "zh-TW": "./languages/ios/zh-Hant.json",
      "zh-HK": "./languages/ios/zh-Hant.json"
    },
    "owner": "leowang1105",
    "extra": {
      "eas": {
        "projectId": "964b2a8d-f108-43c6-a7bb-a3121643aaed"
      }
    }
  }
}
